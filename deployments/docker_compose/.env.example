# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# REQUIRED - set for your environment
AUTHENTIK_CLIENT_ID=CHANGE_ME

# SECRET - set a strong value
AUTHENTIK_CLIENT_SECRET=CHANGE_ME

# SECRET - set a strong value (must match the POSTGRES_* values)
DATABASE_URL=CHANGE_ME

# SECRET - set a strong value
HOMEPAGE_WIDGET_KEY=CHANGE_ME

# SECRET - set a strong value
NEXTAUTH_SECRET=CHANGE_ME

# SECRET - set a strong value
POSTGRES_PASSWORD=CHANGE_ME

# default: linkwarden
POSTGRES_DB=linkwarden

# default: linkwarden
POSTGRES_USER=linkwarden
